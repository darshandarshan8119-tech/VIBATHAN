DJANGO_SETTINGS_MODULE=agrimart.settings
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=sqlite:///market_intelligence.db.sqlite3
REDIS_URL=redis://localhost:6379/0
JWT_ISSUER=agrimart
JWT_AUDIENCE=agrimart-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
FIELD_ENCRYPTION_KEYS=dev-key-id:dev-32-byte-placeholder-key!!!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration
# Set LLM_PROVIDER to either 'gemini' or 'openrouter' (both keys can coexist below without deletion)
LLM_PROVIDER=gemini

# Provider Keys (keep both populated - system routes based on LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Provider Models (optional overrides; defaults are automatic):
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free


