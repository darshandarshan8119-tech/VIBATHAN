DJANGO_SETTINGS_MODULE=agrimart.settings
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=sqlite:///market_intelligence.db.sqlite3
REDIS_URL=redis://localhost:6379/0
JWT_ISSUER=agrimart
JWT_AUDIENCE=agrimart-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
FIELD_ENCRYPTION_KEYS=dev-key-id:dev-32-byte-placeholder-key!!!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration
# OPTION A: OpenRouter (Recommended for 100% Free Models)
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Additional Free OpenRouter Models:
# LLM_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
# LLM_MODEL=deepseek/deepseek-r1:free
# LLM_MODEL=mistralai/mistral-7b-instruct:free
# LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# OPTION B: Google Gemini Direct
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy...your_gemini_api_key_here...
# LLM_MODEL=gemini-3.5-flash-lite
